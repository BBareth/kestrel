# Normalise to LF in the repository; check out native on Windows.
* text=auto

*.py   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini  text eol=lf
*.mako text eol=lf
*.sh   text eol=lf
*.webmanifest text eol=lf
Dockerfile text eol=lf
Caddyfile* text eol=lf

*.svg  text eol=lf
*.png  binary
*.jpg  binary
*.webp binary

# Lockfiles are generated: collapse them in diffs and reviews.
frontend/package-lock.json linguist-generated=true
