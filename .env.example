# Kestrel configuration. Copy to .env and `chmod 600 .env`. NEVER commit .env.
# Helpers:  docker compose run --rm --no-deps api python -m app.cli gen-secret
#           docker compose run --rm --no-deps api python -m app.cli gen-vapid

# --- required ------------------------------------------------------------------
# Hex only (it is embedded in the database URL): openssl rand -hex 24
POSTGRES_PASSWORD=change-me-hex-only
# Signs CSRF tokens and encrypts 2FA secrets. At least 32 characters.
AUTH_SECRET=change-me-at-least-32-characters-long

# --- web -------------------------------------------------------------------------
# LAN IP or hostname the TLS certificate is issued for (Caddy internal CA).
KESTREL_HOST=192.168.1.178
KESTREL_HTTPS_PORT=8443
# Plain-HTTP port: only serves /kestrel-ca.crt and redirects to HTTPS.
KESTREL_HTTP_PORT=8089
# Origins allowed to make state-changing requests (CSRF defence in depth).
ALLOWED_ORIGINS=https://192.168.1.178:8443,https://localhost:8443
COOKIE_SECURE=true
SESSION_TTL_HOURS=336
SESSION_IDLE_HOURS=72

# --- OpenAI (optional; without it the AI layer is disabled) --------------------------
OPENAI_API_KEY=

# --- Binance (optional; without keys only PAPER trading is possible) -----------------
# The key MUST NOT have withdrawal permission and MUST be IP-restricted:
# Kestrel refuses live trading otherwise. See docs/SECURITY.md.
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true = live orders go to Binance's futures testnet (demo-fapi.binance.com)
BINANCE_TESTNET=false

# --- Web Push (VAPID) -----------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact URL that push services may use to reach the operator
VAPID_SUBJECT=https://example.com

# --- misc ----------------------------------------------------------------------------
PAPER_STARTING_BALANCE=10000
LOG_LEVEL=INFO
BACKUP_RETENTION_DAYS=14
BACKUP_HOUR_UTC=3
