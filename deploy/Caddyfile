# Kestrel reverse proxy: TLS (Caddy's internal CA), static PWA, /api → FastAPI.
{
	admin off
	local_certs
	skip_install_trust
	auto_https disable_redirects
	default_sni {$KESTREL_HOST:localhost}
	log {
		output stdout
		format json
	}
}

(hardening) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
		-Server
	}
}

https://{$KESTREL_HOST:localhost}, https://localhost {
	tls internal
	import hardening
	encode zstd gzip
	request_body {
		max_size 1MB
	}

	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				read_timeout 180s
			}
		}
	}
	handle /sw.js {
		root * /srv
		header Cache-Control "no-cache"
		header Service-Worker-Allowed "/"
		file_server
	}
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv
		@shell path / /index.html /manifest.webmanifest
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

# Plain HTTP (LAN only): serves Caddy's root CA for installing on iPhone, redirects everything else.
http:// {
	import hardening
	handle /kestrel-ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type "application/x-x509-ca-cert"
		header Content-Disposition "attachment; filename=kestrel-ca.crt"
		file_server
	}
	handle /healthz {
		respond "ok" 200
	}
	handle {
		redir https://{$KESTREL_HOST:localhost}:{$KESTREL_HTTPS_PORT:8443}{uri} 302
	}
}
